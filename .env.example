# Required source API keys.
DATA_GO_KR_SERVICE_KEY=
BIZINFO_CRTFC_KEY=

# Recommended MCP token. If omitted, the server generates one and appends it to .env.
GRANT_RADAR_TOKEN=

# Optional runtime settings.
PORT=13280
GRANT_CACHE=.cache/grants.json
KSTARTUP_PAGE=1
KSTARTUP_PER_PAGE=30
BIZINFO_SEARCH_CNT=30
